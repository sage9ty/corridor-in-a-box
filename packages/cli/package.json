{
  "name": "@corridor/cli",
  "version": "0.1.0",
  "description": "Validate a corridor manifest and print an offline runnability plan.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ezedike-evan/corridor-in-a-box.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/ezedike-evan/corridor-in-a-box/issues"
  },
  "homepage": "https://github.com/ezedike-evan/corridor-in-a-box#readme",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "corridor": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./wire": "./src/wire.ts"
  },
  "main": "./src/index.ts",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node init && tsup"
  },
  "dependencies": {
    "@corridor/adapter-kit": "workspace:*",
    "@corridor/engine": "workspace:*",
    "@corridor/manifest": "workspace:*",
    "@corridor/probe": "workspace:*",
    "@corridor/registry": "workspace:*",
    "@corridor/router": "workspace:*",
    "@corridor/sep31": "workspace:*",
    "@corridor/stellar": "workspace:*",
    "@corridor/types": "workspace:*",
    "pg": "^8.23.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "tsup": "^9.0.0"
  }
}
