{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@corridor/types": ["./packages/types/src/index.ts"],
      "@corridor/manifest": ["./packages/manifest/src/index.ts"],
      "@corridor/manifest/liveness": ["./packages/manifest/src/liveness.ts"],
      "@corridor/probe": ["./packages/probe/src/index.ts"],
      "@corridor/adapter-kit": ["./packages/adapter-kit/src/index.ts"],
      "@corridor/sep31": ["./packages/sep31/src/index.ts"],
      "@corridor/sep6": ["./packages/sep6/src/index.ts"],
      "@corridor/router": ["./packages/router/src/index.ts"],
      "@corridor/router/testing": ["./packages/router/src/testing.ts"],
      "@corridor/engine": ["./packages/engine/src/index.ts"],
      "@corridor/stellar": ["./packages/stellar/src/index.ts"],
      "@corridor/service": ["./packages/service/src/index.ts"],
      "@corridor/cli": ["./packages/cli/src/index.ts"],
      "@corridor/cli/*": ["./packages/cli/src/*"]
    }
  },
  "include": ["packages/*/src/**/*.ts", "examples/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts"]
}
