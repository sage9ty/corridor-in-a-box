# corridor-in-a-box — example environment
#
# The library packages take their configuration as constructor OPTIONS, not from
# process.env (so they stay embeddable). These variables are the convention for
# the thin deployment layer you write around them — your service entrypoint reads
# these and wires StellarSettlementSubmitter / PostgresIdempotencyStore / createService.
#
# Copy to .env.local and fill in. NEVER commit a real secret. The signing seed
# below is for testnet/dev ONLY — in production implement an ExternalSigner over a
# KMS/HSM so the seed never enters the process (see docs/key-management.md).

# --- Stellar settlement leg ---
# https://horizon-testnet.stellar.org  (testnet)  |  https://horizon.stellar.org  (public)
HORIZON_URL=https://horizon-testnet.stellar.org
# Dev/testnet only. Production: leave unset and back the submitter with an ExternalSigner.
CORRIDOR_SIGNER_SECRET=

# --- examples/run-testnet.ts (pnpm testnet) ---
# Path to the corridor manifest to run. Defaults to corridors/reference.corridor.yaml.
MANIFEST=corridors/reference.corridor.yaml
# Set to move real money on a `network: public` (mainnet) corridor. Refuses to
# run one otherwise.
CORRIDOR_ALLOW_MAINNET=

# --- corridor canary (pnpm cli canary, MOVES MONEY) ---
# One tiny real payment whose settlement is read back from Horizon and, with
# --write, recorded as the manifest's `proof` block (the PROVEN liveness tier).
# The amount is a required flag and is capped at proof.canary_max_amount
# (default 10.00 until a lane-specific cap is recorded).
# Optional overrides — the command registers SEP-12 customers itself when these
# are unset.
SENDER_ID=
RECIPIENT_ID=
RECIPIENT_SEP12_ID=
IDEMPOTENCY_KEY=

# --- Durable idempotency store ---
# Any Postgres connection string; the store needs a `pg.Pool`-compatible client.
# Also read by `pnpm cli breaker status|reset` (see docs/operations.md §7), so the
# CLI and the service can never disagree about whether a lane is halted. It needs
# the `corridor_breakers` table from migrate() if you adopt the breaker.
DATABASE_URL=postgres://corridor:corridor@localhost:5432/corridor

# --- Service (@corridor/service, launched via examples/run-service.ts / pnpm serve) ---
PORT=8080
# Comma-separated bearer keys accepted by the API. Empty = no auth (dev only).
CORRIDOR_API_KEYS=
# Token-bucket rate limit (per client). Omit to disable.
CORRIDOR_RATELIMIT_CAPACITY=20
CORRIDOR_RATELIMIT_REFILL_PER_SEC=5
# Directory to load corridor manifests from. Defaults to corridors/.
CORRIDORS_DIR=corridors

# --- web/ showcase app (optional) ---
# Point the "Run a payment" page at a running @corridor/service instead of the
# in-process simulation. Unset = use the local simulation.
CORRIDOR_SERVICE_URL=
# REQUIRED whenever CORRIDOR_SERVICE_URL is set. The web route is public; without
# a gate it would forward any anonymous caller's body to the real engine WITH the
# server's API key attached, turning a key-protected payments API into an open
# one. Callers must send `Authorization: Bearer <this>`. The route fails closed
# (503) if CORRIDOR_SERVICE_URL is set and this is not.
CORRIDOR_WEB_API_KEY=
# The key the web route presents to @corridor/service on the caller's behalf.
CORRIDOR_SERVICE_API_KEY=

# --- Integration test (tests/integration, opt-in) ---
# Set these to run the adapter against a real SEP-31 server. Unset = the
# integration suite is skipped.
#
# Known-good public values — the SDF test anchor on testnet, verified
# 2026-07-12 (SEP-10 auth, firm SEP-38 quote, SEP-12 status, all green):
#   ANCHOR_HOME_DOMAIN=testanchor.stellar.org
#   ANCHOR_SEP31_TRANSFER_SERVER=https://testanchor.stellar.org/sep31
#   ANCHOR_SEP31_QUOTE_SERVER=https://testanchor.stellar.org/sep38
#   ANCHOR_SEP31_WEB_AUTH=https://testanchor.stellar.org/auth
#   ANCHOR_SEP31_KYC_SERVER=https://testanchor.stellar.org/sep12
#   ANCHOR_ASSET_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
#   ANCHOR_DEST_ASSET=iso4217:USD
# plus CORRIDOR_SIGNER_SECRET above set to any funded testnet key
# (https://friendbot.stellar.org?addr=G...) so SEP-10 auth can run.
ANCHOR_SEP31_TRANSFER_SERVER=
ANCHOR_SEP31_QUOTE_SERVER=
ANCHOR_SEP31_WEB_AUTH=
ANCHOR_SEP31_KYC_SERVER=
ANCHOR_HOME_DOMAIN=
# The anchor's issuing account for the bridge asset (SEP-38 sell side) and the
# off-chain asset to quote into. Defaults: GTEST / iso4217:USD.
ANCHOR_ASSET_ISSUER=
ANCHOR_DEST_ASSET=
# Identifier used for the recipient in the live test request (defaults: integration-recipient, crash-recipient, crash-recipient-pg).
ANCHOR_RECIPIENT_ID=
# Source asset amount to quote and transfer in the live test suite (default 10).
ANCHOR_AMOUNT=10
# SEP-12 customer id the anchor issued for the RECEIVER, from `PUT /customer`.
# Optional: without it the live suite skips the compliance probe, because
# ensureCompliance fails closed on a recipient it cannot identify.
ANCHOR_RECIPIENT_SEP12_ID=

# --- Live settlement capture (MOVES MONEY, opt-in on top of the above) ---
# Set CORRIDOR_LIVE_SETTLEMENT=1 to let the live suite run one full execute()
# and assert the run reaches the terminal state `completed` through
# settled -> reconciled -> completed. Everything else in that suite is
# read-only; this is not, so an anchor being configured is deliberately NOT
# enough to enable it.
#
# It also needs SEP-12 ids for BOTH parties — SEP-31 identifies the sender to
# the receiving anchor as well as the receiver — and they come from
# `PUT /customer`, a write this suite does not perform. Missing either one
# skips the case rather than failing it. `pnpm testnet` (examples/run-testnet.ts)
# registers both and prints the ids.
CORRIDOR_LIVE_SETTLEMENT=
SENDER_SEP12_ID=
# Payout instructions the destination anchor requires, from its
# GET /sep31/info `fields.transaction`. Defaults are the Anchor Platform
# reference server's.
RECEIVER_ROUTING_NUMBER=
RECEIVER_ACCOUNT_NUMBER=
RECEIVER_DEPOSIT_TYPE=
# How long to wait for the anchor's own reconcile cadence. Default 300000 (5m).
CORRIDOR_LIVE_SETTLEMENT_TIMEOUT_MS=

# --- Postgres integration tests (opt-in) ---
# Connection string for a real Postgres database used by integration tests.
# Enables tests/integration/idempotency-pg.test.ts and the Postgres variant of
# tests/integration/crash-resume.test.ts (the latter also needs the anchor vars
# above and CORRIDOR_SIGNER_SECRET; the in-memory crash-resume suite needs only
# those). Unset = only the Postgres suites are skipped.
CORRIDOR_TEST_DATABASE_URL=
# Horizon endpoint override read by crash-resume.test.ts (defaults to https://horizon-testnet.stellar.org).
CORRIDOR_HORIZON_URL=
